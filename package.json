{
  "activationEvents": [
    "onView:skillmap-view",
    "workspaceContains:**/SKILL.md",
    "onCommand:skillmap.selectRoot"
  ],
  "author": {
    "name": "Masanori Satake"
  },
  "bugs": {
    "url": "https://github.com/masanori-satake/SkillMap-Solo/issues"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "category": "SkillMap",
        "command": "skillmap.refresh",
        "icon": "$(refresh)",
        "title": "%command.refresh%"
      },
      {
        "category": "SkillMap",
        "command": "skillmap.openTip",
        "icon": "$(book)",
        "title": "%command.openTip%"
      },
      {
        "category": "SkillMap",
        "command": "skillmap.openFile",
        "icon": "$(go-to-file)",
        "title": "%command.openFile%"
      },
      {
        "category": "SkillMap",
        "command": "skillmap.showLoadMatrix",
        "icon": "$(table)",
        "title": "%command.showLoadMatrix%"
      },
      {
        "category": "SkillMap",
        "command": "skillmap.expandAll",
        "icon": "$(expand-all)",
        "title": "%command.expandAll%"
      },
      {
        "command": "skillmap.copyTree",
        "title": "%command.copyTree%",
        "category": "SkillMap",
        "icon": "$(copy)"
      },
      {
        "command": "skillmap.copyVisibleTree",
        "title": "%command.copyVisibleTree%",
        "category": "SkillMap",
        "icon": "$(clippy)"
      },
      {
        "command": "skillmap.selectRoot",
        "title": "%command.selectRoot%",
        "category": "SkillMap",
        "icon": "$(list-filter)"
      }
    ],
    "configuration": {
      "properties": {
        "skillmap.beta.loadSimulation": {
          "default": true,
          "description": "%config.betaLoadSimulation%",
          "type": "boolean"
        },
        "skillmap.beta.specs": {
          "default": true,
          "description": "%config.betaSpecs%",
          "type": "boolean"
        },
        "skillmap.canonicalRoots": {
          "default": [
            ".agents"
          ],
          "description": "%config.canonicalRoots%",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skillmap.copyTreeStyle": {
          "type": "string",
          "enum": [
            "unicode",
            "ascii"
          ],
          "default": "unicode",
          "description": "%config.copyTreeStyle%"
        },
        "skillmap.rules.descriptionMaxLength": {
          "default": 1024,
          "description": "%config.descriptionMaxLength%",
          "minimum": 0,
          "type": "number"
        },
        "skillmap.rules.maxReferenceDepth": {
          "default": 2,
          "description": "%config.maxReferenceDepth%",
          "minimum": 0,
          "type": "number"
        },
        "skillmap.rules.orphanFiles": {
          "default": "info",
          "description": "%config.orphanFiles%",
          "enum": [
            "off",
            "info",
            "warn"
          ],
          "type": "string"
        },
        "skillmap.rules.skillBodyMaxLines": {
          "default": 500,
          "description": "%config.skillBodyMaxLines%",
          "minimum": 0,
          "type": "number"
        },
        "skillmap.rules.skillBodyMaxTokens": {
          "default": 5000,
          "description": "%config.skillBodyMaxTokens%",
          "minimum": 0,
          "type": "number"
        },
        "skillmap.rules.skillTotalTokenBudget": {
          "default": 0,
          "description": "%config.skillTotalTokenBudget%",
          "minimum": 0,
          "type": "number"
        },
        "skillmap.rules.steeringAlwaysTokenBudget": {
          "default": 0,
          "description": "%config.steeringAlwaysTokenBudget%",
          "minimum": 0,
          "type": "number"
        },
        "skillmap.skillsRoots": {
          "default": [],
          "description": "%config.skillsRoots%",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "SkillMap"
    },
    "menus": {
      "view/item/context": [
        {
          "command": "skillmap.openTip",
          "group": "inline",
          "when": "view == skillmap-view && viewItem =~ /hasWarnings/"
        },
        {
          "command": "skillmap.openFile",
          "group": "inline",
          "when": "view == skillmap-view && viewItem =~ /openable/"
        }
      ],
      "view/title": [
        {
          "command": "skillmap.refresh",
          "group": "navigation@1",
          "order": 1,
          "when": "view == skillmap-view"
        },
        {
          "command": "skillmap.showLoadMatrix",
          "group": "navigation@2",
          "order": 2,
          "when": "view == skillmap-view"
        },
        {
          "command": "skillmap.selectRoot",
          "group": "navigation@3",
          "order": 3,
          "when": "view == skillmap-view && skillmap.multiRoot"
        },
        {
          "command": "skillmap.copyTree",
          "when": "view == skillmap-view",
          "group": "navigation@4",
          "order": 4
        },
        {
          "command": "skillmap.copyVisibleTree",
          "when": "view == skillmap-view",
          "group": "navigation@5",
          "order": 5
        },
        {
          "command": "skillmap.expandAll",
          "group": "navigation@6",
          "order": 6,
          "when": "view == skillmap-view"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "contextualTitle": "SkillMap",
          "icon": "$(graph)",
          "id": "skillmap-view",
          "name": "%view.name%"
        }
      ]
    }
  },
  "description": "%skillmap.description%",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.1"
  },
  "displayName": "SkillMap-Solo",
  "engines": {
    "vscode": "^1.90.0"
  },
  "homepage": "https://github.com/masanori-satake/SkillMap-Solo#readme",
  "icon": "icon.png",
  "keywords": [
    "agent skills",
    "skill",
    "ai",
    "context",
    "kiro",
    "copilot",
    "steering",
    "specs",
    "references",
    "token"
  ],
  "license": "MIT",
  "main": "./dist/extension.js",
  "name": "skillmap-solo",
  "publisher": "masanori-satake",
  "repository": {
    "type": "git",
    "url": "https://github.com/masanori-satake/SkillMap-Solo.git"
  },
  "scripts": {
    "check-readme-anchors": "node scripts/check-readme-anchors.js",
    "check-types": "tsc --noEmit",
    "check-version": "node scripts/check-version.js",
    "check-version-bump": "node scripts/check-version.js --check-bump",
    "compile": "npm run check-version && npm run check-types && npm run lint && node esbuild.js",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src && npm run check-readme-anchors",
    "package": "npm run check-version && npm run check-types && npm run lint && node esbuild.js --production",
    "pretest": "npm run compile-tests",
    "test": "node --test \"out/test/*.test.js\"",
    "update-version": "node scripts/update-version.js",
    "vscode:prepublish": "node esbuild.js --production",
    "watch": "node esbuild.js --watch"
  },
  "version": "1.8.4"
}
